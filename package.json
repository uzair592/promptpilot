{
  "name": "promptpilot",
  "version": "0.1.0",
  "description": "AI-powered context engineering and prompt optimization platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm typecheck",
    "dev": "pnpm typecheck --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node tests/acceptance/run.mjs",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "@playwright/test": "^1.55.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
